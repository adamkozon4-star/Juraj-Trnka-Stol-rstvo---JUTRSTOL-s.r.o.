---
// Predmet, ktorý „leží“ na hranici dvoch sekcií – polovica v predchádzajúcej, polovica v tejto.
// Vkladá sa ako prvý prvok do sekcie (sekcia musí mať position: relative).
import { Image } from 'astro:assets';
import Pencil from './Pencil.astro';
import FoldingRuler from './FoldingRuler.astro';
import { photo } from '../lib/images';

interface Props {
  kind: 'photo' | 'pencil' | 'ruler';
  side?: 'left' | 'right';
  inset?: string; // vzdialenosť od okraja, napr. '4%'
  rotate?: number;
  image?: string; // pre kind="photo"
  label?: string; // krátky popis na štítku pri fotke
  size?: 'sm' | 'md' | 'lg';
}
const { kind, side = 'right', inset = '4%', rotate = 0, image, label, size = 'md' } = Astro.props;

const widths = {
  photo: { sm: 'w-28 lg:w-36', md: 'w-32 lg:w-48', lg: 'w-36 lg:w-56' },
  pencil: { sm: 'w-56 lg:w-72', md: 'w-64 lg:w-[26rem]', lg: 'w-72 lg:w-[30rem]' },
  ruler: { sm: 'w-48 lg:w-64', md: 'w-56 lg:w-80', lg: 'w-64 lg:w-96' },
}[kind][size];
---

<div
  class:list={['bridge pointer-events-none absolute top-0 z-30', widths, kind === 'photo' ? 'hidden sm:block' : 'hidden md:block']}
  style={`${side}:${inset};--r:${rotate}deg`}
  aria-hidden="true"
>
  <div class="bridge-inner">
    {
      kind === 'photo' && image && (
        <div class="relative">
          <div class="aspect-square overflow-hidden rounded-full bg-paper p-2 shadow-[0_30px_60px_-20px_rgba(29,26,23,0.55),0_0_0_1px_rgba(29,26,23,0.06)]">
            <Image src={photo(image)} alt="" widths={[240, 400]} sizes="14rem" class="h-full w-full rounded-full object-cover" />
          </div>
          {label && (
            <span class="script absolute -bottom-3 left-1/2 -translate-x-1/2 rounded-full bg-paper px-4 py-1 text-xl whitespace-nowrap text-copper shadow-md">
              {label}
            </span>
          )}
        </div>
      )
    }
    {kind === 'pencil' && <Pencil class="w-full" />}
    {kind === 'ruler' && <FoldingRuler class="w-full" angles={[0, 162]} start={60} />}
  </div>
</div>

<style>
  .bridge {
    transform: translateY(-50%);
  }
  .bridge-inner {
    transform: rotate(var(--r));
  }
  /* Jemné pootočenie a posun pri scrollovaní (moderné prehliadače) */
  @supports (animation-timeline: view()) {
    .bridge-inner {
      animation: bridge-drift linear both;
      animation-timeline: view();
      animation-range: cover 0% cover 100%;
    }
  }
  @keyframes bridge-drift {
    from {
      transform: translateY(28px) rotate(calc(var(--r) - 6deg));
    }
    to {
      transform: translateY(-28px) rotate(calc(var(--r) + 6deg));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bridge-inner {
      animation: none !important;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import { photo } from '../lib/images';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image?: string;
  crumbs?: { href: string; label: string }[];
}
const { eyebrow, title, lead, image, crumbs = [] } = Astro.props;
---

<section class="wood-grain relative isolate overflow-hidden bg-walnut pt-36 pb-20 text-white lg:pt-44 lg:pb-28">
  {
    image && (
      <>
        <Image
          src={photo(image)}
          alt=""
          widths={[640, 1280, 1920]}
          sizes="100vw"
          loading="eager"
          class="absolute inset-0 -z-20 h-full w-full object-cover opacity-35"
        />
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-walnut via-walnut/85 to-walnut/40" />
      </>
    )
  }
  <div class="container-x">
    {
      crumbs.length > 0 && (
        <nav aria-label="Omrvinky" class="mb-8 text-sm text-white/55">
          <ol class="flex flex-wrap items-center gap-2">
            <li>
              <a href="/" class="hover:text-white">
                Úvod
              </a>
            </li>
            {crumbs.map((c) => (
              <li class="flex items-center gap-2">
                <span aria-hidden="true">/</span>
                <a href={c.href} class="hover:text-white">
                  {c.label}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <p class="eyebrow !text-oak">{eyebrow}</p>
    <h1 class="mt-5 max-w-4xl text-4xl leading-[1.05] font-medium sm:text-6xl" set:html={title} />
    {lead && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/70">{lead}</p>}
  </div>
</section>

---
// Dočasné textové logo, kým nedostaneme originál od klienta.
interface Props {
  tone?: 'light' | 'dark';
}
const { tone = 'dark' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-3', tone === 'light' ? 'text-white' : 'text-ink']}>
  <svg width="34" height="34" viewBox="0 0 40 40" aria-hidden="true" class="shrink-0">
    <rect x="1" y="1" width="38" height="38" rx="9" fill="none" stroke="currentColor" stroke-opacity=".35" stroke-width="1.5"
    ></rect>
    <path d="M11 11h18" stroke="#c89560" stroke-width="3" stroke-linecap="round"></path>
    <path d="M20 11v13.5a5 5 0 0 1-5 5h-2" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"
    ></path>
    <path d="M26 17v12" stroke="currentColor" stroke-opacity=".55" stroke-width="3" stroke-linecap="round"></path>
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-display text-[1.35rem] font-semibold tracking-[0.04em]">JUTRSTOL</span>
    <span class:list={['mt-1 text-[0.62rem] font-medium tracking-[0.28em] uppercase', tone === 'light' ? 'text-white/65' : 'text-stone']}
      >Stolárstvo · Gbely</span
    >
  </span>
</span>

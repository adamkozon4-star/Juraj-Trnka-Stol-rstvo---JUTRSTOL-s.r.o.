---
// Logo JUTRSTOL: značka „JT“ v drevenom ráme (zdroj: public/logo-jt.svg).
interface Props {
  tone?: 'light' | 'dark';
}
const { tone = 'dark' } = Astro.props;
const uid = `jt-${Math.random().toString(36).slice(2, 8)}`;
const mark = `<defs>     <linearGradient id="${uid}-w" x1="0" y1="0" x2="1" y2="1">       <stop offset="0" stop-color="#dcae78"/>       <stop offset=".55" stop-color="#c8925a"/>       <stop offset="1" stop-color="#a8733f"/>     </linearGradient>     <mask id="${uid}-cut">       <rect width="100" height="100" fill="#fff"/>       <path d="M72 -4 L104 28" stroke="#000" stroke-width="4.2"/>     </mask>   </defs>   <g fill="url(#${uid}-w)">     <path mask="url(#${uid}-cut)" fill-rule="evenodd" d="M15 0H100V85A15 15 0 0 1 85 100H15A15 15 0 0 1 0 85V15A15 15 0 0 1 15 0ZM15.5 5.5A10 10 0 0 0 5.5 15.5V84.5A10 10 0 0 0 15.5 94.5H84.5A10 10 0 0 0 94.5 84.5V5.5Z"/>     <path d="M26 21H85V31H26Z"/>     <path d="M55 31H67V86H55Z"/>     <path d="M35 39H48.5V67C48.5 79 41 86 29 86H15L22 73H29C33 73 35 71 35 67Z"/>   </g> `;
---

<span class:list={['inline-flex items-center gap-3', tone === 'light' ? 'text-white' : 'text-ink']}>
  <svg width="38" height="38" viewBox="0 0 100 100" aria-hidden="true" class="shrink-0" set:html={mark} />
  <span class="flex flex-col leading-none">
    <span class="font-display text-[1.35rem] font-semibold tracking-[0.04em]">JUTRSTOL</span>
    <span class:list={['mt-1 text-[0.62rem] font-medium tracking-[0.28em] uppercase', tone === 'light' ? 'text-white/65' : 'text-stone']}
      >Stolárstvo · Gbely</span
    >
  </span>
</span>

---
import Bridge from '../Bridge.astro';
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';

const steps = [
  {
    title: 'Ozvete sa alebo si nábytok navrhnete',
    text: 'Zavolajte, vyplňte formulár, alebo si kuchyňu či skriňu poskladajte v online konfigurátore a návrh nám pošlite. Na začiatok stačí aj pár viet a fotka priestoru.',
    link: { href: '/konfigurator', label: 'Otvoriť konfigurátor' },
  },
  {
    title: 'Konzultácia a zameranie',
    text: 'Prídeme k vám, všetko presne zameriame a spolu prejdeme vaše predstavy alebo návrh z konfigurátora, materiály a farby.',
  },
  {
    title: 'Presný návrh a cenová ponuka',
    text: 'Návrh doladíme podľa skutočných rozmerov a pripravíme jasnú cenovú ponuku. Upravujeme, kým nie ste spokojní.',
  },
  {
    title: 'Výroba v dielni',
    text: 'Nábytok vyrobíme v našej dielni v Gbeloch s dôrazom na presnosť každého spoja a hrany.',
  },
  {
    title: 'Montáž a odovzdanie',
    text: 'Všetko privezieme, namontujeme, nastavíme a po sebe upraceme. Vy si len užívate výsledok.',
  },
];
---

<section id="postup" data-nav="Ako pracujeme" class="sheet sheet-dark !bg-walnut pt-24 pb-32 text-white lg:pt-28 lg:pb-40">
  <Bridge kind="photo" side="right" inset="6%" rotate={6} size="lg" image="predsiene/predsien-vstavana-skrina-led-01.jpg" label="LED" />

  <div class="container-x grid gap-16 lg:grid-cols-[0.9fr_1.1fr] lg:gap-24">
    <div class="lg:sticky lg:top-32 lg:self-start">
      <SectionHeading
        tone="light"
        eyebrow="Ako pracujeme"
        title="Od prvého nápadu po hotový nábytok"
        lead="Začať môžete telefonátom, formulárom alebo vlastným návrhom v konfigurátore. Zvyšok máme v rukách my – nemusíte koordinovať návrhára, výrobu ani montážnikov."
      />
    </div>

    <div class="relative pl-14 sm:pl-20">
      <!-- Meter ako os postupu -->
      <div class="step-ruler absolute top-2 bottom-2 left-0 w-8 rounded-md sm:w-10" aria-hidden="true"></div>
      <ol class="relative space-y-12 sm:space-y-14">
        {
          steps.map((s, i) => (
            <li data-reveal style={`--d:${i * 70}ms`} class="group relative">
              <span class="absolute top-3 -left-14 h-0.5 w-10 bg-copper sm:-left-20 sm:w-14" aria-hidden="true" />
              <p class="text-xs font-semibold tracking-[0.18em] text-oak uppercase">Krok {i + 1}</p>
              <h3 class="mt-2 text-2xl font-semibold sm:text-[1.7rem]">{s.title}</h3>
              <p class="mt-2 max-w-md leading-relaxed text-white/65">{s.text}</p>
              {s.link && (
                <a href={s.link.href} class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-oak hover:text-white">
                  <Icon name="cube" size={16} /> {s.link.label} <Icon name="arrow" size={14} />
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .step-ruler {
    background:
      linear-gradient(to bottom, #b3261e 1.5px, transparent 1.5px) right top / 60% 50px repeat-y,
      linear-gradient(to bottom, #2a221a 1px, transparent 1px) right top / 40% 25px repeat-y,
      linear-gradient(to bottom, rgba(42, 34, 26, 0.7) 1px, transparent 1px) right top / 22% 5px repeat-y,
      linear-gradient(90deg, #f6dc7a, #e6bf4c);
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.7);
  }
</style>

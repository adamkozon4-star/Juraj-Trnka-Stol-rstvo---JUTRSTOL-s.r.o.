---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { photo } from '../../lib/images';
import { site } from '../../data/site';

const ready = Boolean(site.configuratorUrl);
---

<section id="konfigurator" data-nav="Konfigurátor" class="sheet pt-24 pb-32 lg:pt-28 lg:pb-40">

  <div class="container-x">
    <div class="relative grid overflow-hidden rounded-[2.5rem] bg-cream lg:grid-cols-2">
      <div class="relative z-10 p-8 sm:p-12 lg:p-16" data-reveal>
        <p class="eyebrow">
          {ready ? 'Online konfigurátor' : 'Pripravujeme'}
        </p>
        <h2 class="mt-5 text-4xl leading-[1.08] font-medium sm:text-5xl">
          Navrhnite si nábytok online
        </h2>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-stone">
          {
            ready
              ? 'Zadajte rozmery, vyberte dekor a vnútorné usporiadanie – a hneď uvidíte, ako bude váš nábytok vyzerať.'
              : 'Čoskoro si tu sami poskladáte skriňu či kuchyňu – rozmery, dekor aj vnútro. Dovtedy vám návrh radi pripravíme osobne.'
          }
        </p>
        <ul class="mt-8 space-y-3 text-[15px]">
          {
            ['Vlastné rozmery na centimeter', 'Výber dekorov a farieb', 'Návrh priamo odošlete nám'].map((t) => (
              <li class="flex items-center gap-3">
                <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-copper/15 text-copper">
                  <Icon name="check" size={14} />
                </span>
                {t}
              </li>
            ))
          }
        </ul>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <a href="/konfigurator" class="btn-primary">
            <Icon name="cube" size={18} />
            {ready ? 'Spustiť konfigurátor' : 'Viac o konfigurátore'}
          </a>
          {!ready && <a href="#kontakt" class="btn-outline">Chcem návrh hneď</a>}
        </div>
      </div>
      <div class="relative min-h-72 lg:min-h-full">
        <Image
          src={photo('skrine-satniky/skrina-detska-izba-dub-siva-nika-03-otvorena-sirka.jpg')}
          alt="Otvorená skriňa na mieru s policami a zásuvkami"
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <span class="absolute inset-0 bg-gradient-to-r from-cream via-cream/10 to-transparent max-lg:bg-gradient-to-b max-lg:from-cream" />
      </div>
    </div>
  </div>
</section>

---
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';
import { site, telHref } from '../../data/site';

// Odpovede podľa odovzdávacieho dotazníka od klienta
const faqs = [
  {
    q: 'Koľko stojí kuchyňa alebo skriňa na mieru?',
    a: 'Cena závisí od rozmerov, materiálov, kovania a spotrebičov. Cenu stanovujeme až po zameraní u vás, aby bola presná – vopred a bez skrytých položiek.',
  },
  {
    q: 'Ako dlho trvá výroba?',
    a: `Dodacia lehota je ${site.deliveryWeeks} v závislosti od náročnosti výroby a zvolených materiálov. Presný termín montáže vám povieme pri cenovej ponuke.`,
  },
  {
    q: 'V akej oblasti pôsobíte?',
    a: 'Dielňu máme v Gbeloch. Pracujeme v okresoch Skalica, Senica, Myjava a Malacky, v Trenčíne a Bratislave, na Morave v okolí Hodonína a v Brne, a aj v Prahe.',
  },
  {
    q: 'Z akých materiálov vyrábate?',
    a: 'Vyrábame z lamina a lakovanej MDF, používame aj sklo a zrkadlá. Dekory si vyberiete zo vzorkovníka Egger, prípadne Kaindl a Kronospan. Používame kovanie Blum s tlmeným dovieraním a úchytky podľa vášho výberu.',
  },
  {
    q: 'Zabezpečíte aj montáž a spotrebiče?',
    a: 'Montáž robíme vždy sami, aby všetko sedelo presne podľa návrhu. Spotrebiče zabudujeme podľa vášho výberu a pri návrhu s nimi rovno počítame. Dopravu účtujeme podľa vzdialenosti miesta montáže.',
  },
  {
    q: 'Je zameranie a návrh zadarmo?',
    a: 'Áno, ak sa rozhodnete pre realizáciu u nás, zameranie aj návrh sú zadarmo.',
  },
  {
    q: 'Čo potrebujete, aby ste mi pripravili ponuku?',
    a: 'Na začiatok stačí krátky popis, približné rozmery a fotka miestnosti. Presné rozmery si potom zameriame sami priamo u vás.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section id="faq" data-nav="Otázky" class="sheet !bg-cream pt-24 pb-32 lg:pt-28 lg:pb-40">

  <div class="container-x grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
    <div class="lg:sticky lg:top-32 lg:self-start">
      <SectionHeading
        eyebrow="Časté otázky"
        title="Čo sa nás ľudia najčastejšie pýtajú"
      />
      <p class="mt-6 text-stone" data-reveal>
        Nenašli ste odpoveď? Zavolajte na{' '}
        <a href={telHref} class="font-semibold text-ink underline decoration-oak underline-offset-4">{site.phoneDisplay}</a>.
      </p>
    </div>

    <div class="divide-y divide-line border-y border-line" data-reveal>
      {
        faqs.map((f) => (
          <details class="group py-2">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left font-display text-xl font-medium [&::-webkit-details-marker]:hidden">
              {f.q}
              <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line text-copper transition duration-300 group-open:rotate-45 group-open:bg-copper group-open:text-white">
                <Icon name="plus" size={18} />
              </span>
            </summary>
            <p class="pr-14 pb-6 leading-relaxed text-stone">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

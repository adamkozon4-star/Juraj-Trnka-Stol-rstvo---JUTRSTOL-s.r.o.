---
import Icon from '../Icon.astro';
import { reviews, reviewsSource, reviewSummary } from '../../data/reviews';

const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter((p) => p.length > 1)
    .map((p) => p[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
// Jemné farby „profilových fotiek“
const tones = ['#c4733a', '#8a6a4f', '#5f7a6b', '#a0525a', '#6b6f8f'];
const pageName = 'Juraj Trnka Stolárstvo';
---

{
  reviews.length > 0 && (
    <section id="recenzie" data-nav="Recenzie" class="sheet !bg-cream relative overflow-x-clip pt-24 pb-24 lg:pt-28 lg:pb-32">
      <div class="container-x">
        <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
          <div class="max-w-2xl">
            <p class="eyebrow">Recenzie</p>
            <h2 class="mt-5 text-4xl leading-[1.02] font-semibold sm:text-5xl">
              Čo hovoria zákazníci
              <span class="script mt-1 block text-copper">po montáži</span>
            </h2>
          </div>
          <div class="hidden gap-2 sm:flex">
            <button type="button" class="rv-nav" data-dir="-1" aria-label="Predchádzajúca recenzia">
              <Icon name="arrowLeft" size={20} />
            </button>
            <button type="button" class="rv-nav" data-dir="1" aria-label="Ďalšia recenzia">
              <Icon name="arrow" size={20} />
            </button>
          </div>
        </div>
      </div>

      <div class="rv-track mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto pt-2 pb-14" data-reveal tabindex="0" aria-label="Recenzie zákazníkov">
        <!-- Súhrn ako hlavička recenzií na Facebooku -->
        <article class="fb-card flex w-[82vw] max-w-[22rem] shrink-0 snap-start flex-col p-6 sm:w-[22rem]">
          <div class="flex items-center gap-3">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-[#1877f2] text-white">
              <Icon name="facebook" size={22} />
            </span>
            <span class="leading-tight">
              <b class="block text-[15px]">Hodnotenia a recenzie</b>
              <span class="text-[13px] text-[#65676b]">{pageName}</span>
            </span>
          </div>
          <p class="mt-6 text-[1.35rem] leading-tight font-bold text-[#050505]">
            {reviewSummary.recommendPercent}&nbsp;% odporúča{' '}
            <span class="text-base font-semibold whitespace-nowrap text-[#65676b]">({reviewSummary.count} recenzií)</span>
          </p>
          <p class="mt-2 mb-6 text-[15px] leading-snug text-[#65676b]">
            Všetci zákazníci, ktorí na Facebooku hodnotili stolárstvo, ho odporúčajú.
          </p>
          <a
            href={reviewsSource}
            target="_blank"
            rel="noopener"
            class="mt-auto flex items-center justify-center gap-2 rounded-lg bg-[#e7f3ff] px-4 py-2.5 text-[15px] font-semibold text-[#1877f2] transition hover:bg-[#dbeaff]"
          >
            Zobraziť na Facebooku
          </a>
        </article>

        {reviews.map((r, i) => (
          <article class="fb-card flex w-[82vw] max-w-[22rem] shrink-0 snap-start flex-col sm:w-[22rem]">
            <div class="flex gap-2.5 p-4 pb-0">
              <span
                class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-sm font-semibold text-white"
                style={`background:${tones[i % tones.length]}`}
                aria-hidden="true"
              >
                {initials(r.name)}
              </span>
              <div class="min-w-0 text-[15px] leading-[1.3]">
                <p class="text-[#65676b]">
                  <b class="font-semibold text-[#050505]">{r.name}</b>{' '}
                  <span class="rec-badge" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="12" height="12"><path fill="#fff" d="M8 1.8l1.8 3.7 4 .6-2.9 2.8.7 4L8 11l-3.6 1.9.7-4L2.2 6.1l4-.6z" /></svg>
                  </span>{' '}
                  odporúča <b class="font-semibold text-[#050505]">{pageName}</b>.
                </p>
                <p class="mt-1 flex items-center gap-1 text-[13px] text-[#65676b]">
                  {r.date} ·
                  <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.4" aria-label="Verejné">
                    <circle cx="8" cy="8" r="6.3" />
                    <path d="M1.8 8h12.4M8 1.7c1.8 1.8 2.6 4 2.6 6.3S9.8 12.5 8 14.3M8 1.7C6.2 3.5 5.4 5.7 5.4 8s.8 4.5 2.6 6.3" />
                  </svg>
                </p>
              </div>
            </div>
            {r.text ? (
              <p class="px-4 pt-3 text-[15px] leading-[1.35] text-[#050505]">{r.text}</p>
            ) : (
              <p class="px-4 pt-3 text-[15px] text-[#65676b] italic">Odporúča bez komentára</p>
            )}
            <div class="mx-4 mt-auto flex items-center gap-6 border-t border-[#ced0d4] pt-2.5 pb-3 text-[#65676b] max-sm:mt-6 sm:mt-auto">
              <span class="inline-flex items-center gap-1.5 text-sm font-semibold" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M7 11v9H4v-9zM7 11l4-7c1.5 0 2.5 1 2.2 2.6L12.7 10H19a2 2 0 0 1 2 2.3l-1.2 6A2 2 0 0 1 17.8 20H7" /></svg>
                Páči sa mi to
              </span>
              <span class="inline-flex items-center gap-1.5 text-sm font-semibold" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20c5 0 9-3.6 9-8s-4-8-9-8-9 3.6-9 8c0 1.8.7 3.5 1.9 4.8L4 21l4.4-1.7c1.1.5 2.3.7 3.6.7z" /></svg>
                Komentovať
              </span>
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  .rv-track {
    padding-inline: max(1rem, calc((100vw - 80rem) / 2 + 2rem));
    scroll-padding-inline: max(1rem, calc((100vw - 80rem) / 2 + 2rem));
    scrollbar-width: none;
  }
  .rv-track::-webkit-scrollbar {
    display: none;
  }
  .fb-card {
    min-height: 15rem;
    border-radius: 0.9rem;
    background: #fff;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.1),
      0 16px 30px -24px rgb(29 26 23 / 0.35);
  }
  .rec-badge {
    display: inline-flex;
    width: 18px;
    height: 16px;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    background: linear-gradient(135deg, #ff6d8a, #e0245e);
    vertical-align: -2px;
  }
  .rv-nav {
    display: inline-flex;
    height: 3rem;
    width: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: white;
    color: var(--color-ink);
    box-shadow: 0 0 0 1px rgb(29 26 23 / 0.08);
    transition:
      background 0.2s,
      color 0.2s,
      opacity 0.2s;
  }
  .rv-nav:hover {
    background: var(--color-walnut);
    color: var(--color-oak);
  }
  .rv-nav:disabled {
    opacity: 0.35;
    pointer-events: none;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const track = document.querySelector<HTMLElement>('.rv-track');
    if (!track) return;
    const buttons = document.querySelectorAll<HTMLButtonElement>('.rv-nav');
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 4;
      buttons.forEach((b) => (b.disabled = b.dataset.dir === '-1' ? track.scrollLeft <= 4 : track.scrollLeft >= max));
    };
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const card = track.querySelector<HTMLElement>('.fb-card');
        const step = (card?.offsetWidth ?? 320) + 16;
        track.scrollBy({ left: step * Number(b.dataset.dir), behavior: 'smooth' });
      }),
    );
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

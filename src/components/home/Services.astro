---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { categories } from '../../data/categories';
import { projectsInCategory } from '../../data/projects';
import { photo } from '../../lib/images';
import { plural } from '../../lib/plural';

const photoCount = (slug: string) => projectsInCategory(slug).reduce((n, p) => n + p.images.length, 0);
---

<section id="sluzby" data-nav="Čo vyrábame" class="sheet !bg-cream pt-24 pb-28 lg:pt-28 lg:pb-36">

  <div class="container-x">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">Čo vyrábame</p>
        <h2 class="mt-5 text-4xl leading-[1.02] font-semibold sm:text-5xl">Od kuchyne až po práčovňu</h2>
      </div>
      <p class="max-w-sm text-stone lg:text-right" data-reveal>
        Prejdite po pásoch a vyberte, čo riešite. Ku každej oblasti nájdete naše realizácie.
      </p>
    </div>

    <ul id="svc" class="svc mt-12" data-reveal style="--d:100ms">
      {
        categories.map((c, i) => (
          <li class="svc-item" data-active={i === 0 ? 'true' : 'false'}>
            <Image
              src={photo(c.cover)}
              alt=""
              widths={[480, 800, 1100]}
              sizes="(min-width: 1024px) 55vw, 100vw"
              class="svc-img"
            />
            <span class="svc-shade" />
            <button type="button" class="svc-toggle" aria-expanded={i === 0 ? 'true' : 'false'} aria-label={c.title} />
            <div class="svc-body">
              <span class="svc-icon">
                <Icon name={c.icon} size={22} />
              </span>
              <div class="svc-text">
                <p class="text-[11px] font-semibold tracking-[0.16em] text-oak uppercase">
                  {plural(projectsInCategory(c.slug).length, 'projekt', 'projekty', 'projektov')} ·{' '}
                  {plural(photoCount(c.slug), 'fotka', 'fotky', 'fotiek')}
                </p>
                <h3 class="mt-1 text-2xl leading-tight font-semibold text-white sm:text-3xl">{c.title}</h3>
                <p class="mt-2 max-w-md text-sm leading-relaxed text-white/75">{c.short}</p>
                <a
                  href={`/sluzby/${c.slug}`}
                  class="mt-4 inline-flex items-center gap-2 rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-ink transition hover:bg-apricot"
                  tabindex={i === 0 ? 0 : -1}
                >
                  Pozrieť realizácie <Icon name="arrow" size={16} />
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .svc {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .svc-item {
    position: relative;
    overflow: hidden;
    border-radius: 2.25rem;
    background: var(--color-walnut);
    height: 4.75rem;
    transition:
      height 0.7s var(--ease-out-soft),
      flex-grow 0.7s var(--ease-out-soft);
    isolation: isolate;
  }
  .svc-item[data-active='true'] {
    height: 25rem;
  }
  .svc-img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) brightness(0.8);
    transform: scale(1.06);
    transition:
      transform 1.2s var(--ease-out-soft),
      filter 0.7s;
  }
  .svc-item[data-active='true'] .svc-img {
    filter: none;
    transform: scale(1);
  }
  .svc-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgba(20, 17, 14, 0.85), rgba(20, 17, 14, 0.1) 60%);
  }
  .svc-toggle {
    position: absolute;
    inset: 0;
    cursor: pointer;
  }
  .svc-item[data-active='true'] .svc-toggle {
    pointer-events: none;
  }
  .svc-body {
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.9rem;
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    pointer-events: none;
  }
  .svc-icon {
    display: inline-flex;
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: white;
    color: var(--color-copper);
    box-shadow: 0 8px 20px -8px rgba(0, 0, 0, 0.5);
  }
  .svc-text {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.4s,
      transform 0.6s var(--ease-out-soft);
    pointer-events: none;
    min-width: 0;
  }
  /* V zbalenom stave na mobile ukáž aspoň názov */
  .svc-item:not([data-active='true']) .svc-text {
    opacity: 1;
    transform: none;
    align-self: center;
  }
  .svc-item:not([data-active='true']) .svc-text > :not(h3) {
    display: none;
  }
  .svc-item:not([data-active='true']) .svc-text h3 {
    font-size: 1.15rem;
    margin: 0;
  }
  .svc-item[data-active='true'] .svc-text {
    opacity: 1;
    transform: none;
    transition-delay: 0.25s;
    pointer-events: auto;
  }

  @media (min-width: 1024px) {
    .svc {
      flex-direction: row;
      height: 34rem;
    }
    .svc-item,
    .svc-item[data-active='true'] {
      height: auto;
      flex: 1 1 0;
      min-width: 4.75rem;
    }
    .svc-item[data-active='true'] {
      flex-grow: 9;
    }
    .svc-body {
      left: 0.85rem;
      bottom: 0.85rem;
    }
    .svc-item:not([data-active='true']) .svc-text {
      display: none;
    }
    .svc-text {
      width: 30rem;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const list = document.getElementById('svc');
    if (!list) return;
    const items = [...list.querySelectorAll<HTMLElement>('.svc-item')];
    const activate = (el: HTMLElement) => {
      items.forEach((it) => {
        const on = it === el;
        it.dataset.active = String(on);
        it.querySelector('.svc-toggle')?.setAttribute('aria-expanded', String(on));
        it.querySelector('a')?.setAttribute('tabindex', on ? '0' : '-1');
      });
    };
    const desktop = window.matchMedia('(min-width: 1024px) and (hover: hover)');
    items.forEach((it) => {
      it.querySelector('.svc-toggle')?.addEventListener('click', () => activate(it));
      it.addEventListener('mouseenter', () => desktop.matches && activate(it));
    });
  });
</script>

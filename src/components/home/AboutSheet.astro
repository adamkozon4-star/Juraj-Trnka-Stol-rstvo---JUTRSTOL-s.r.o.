---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { photo } from '../../lib/images';
import { projects } from '../../data/projects';
import { categories } from '../../data/categories';
import { site } from '../../data/site';

// TODO: doplniť skutočný príbeh a fotku Juraja/dielne
const facts = [
  site.yearsExperience
    ? { value: `${site.yearsExperience}+`, label: 'rokov praxe' }
    : { value: String(projects.length), label: 'realizácií v galérii' },
  { value: String(categories.length), label: 'druhov nábytku' },
  { value: '1', label: 'kontakt od návrhu po montáž' },
];
---

<section id="o-nas" data-nav="O nás" class="sheet overflow-x-clip pt-40 pb-28 sm:pt-44 lg:pt-48 lg:pb-36">

  <div class="container-x grid items-center gap-16 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
    <div data-reveal>
      <p class="eyebrow">O nás</p>
      <h2 class="mt-5 text-4xl leading-[1.02] font-semibold sm:text-5xl">
        Stolárstvo, kde vás od návrhu po montáž vedie jeden človek
      </h2>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-stone">
        Za značkou JUTRSTOL stojí stolár {site.owner}. Nábytok navrhujeme presne do vášho priestoru, do šikmín, pod schody
        aj na centimeter k stropu, a vyrábame ho vo vlastnej dielni v Gbeloch.
      </p>

      <dl class="mt-10 grid max-w-xl grid-cols-3 divide-x divide-line border-y border-line">
        {
          facts.map((f, i) => (
            <div class:list={['flex flex-col-reverse justify-end py-6', i === 0 ? 'pr-4' : 'px-4 sm:px-6']}>
              <dt class="mt-1 text-sm leading-snug text-stone">{f.label}</dt>
              <dd class="font-display text-4xl font-semibold tabular-nums sm:text-5xl">{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-9 flex items-center gap-5">
        <p class="script text-5xl text-copper" aria-hidden="true">{site.owner}</p>
        <span class="h-px flex-1 bg-line"></span>
        <a href="#kontakt" class="btn-outline shrink-0">Spoznajme sa <Icon name="arrow" size={16} /></a>
      </div>
    </div>

    <div class="relative" data-reveal style="--d:120ms">
      <div class="overflow-hidden rounded-[2.5rem] shadow-[0_40px_80px_-40px_rgba(29,26,23,0.55)]">
        <Image
          src={photo('predsiene/predsien-lamely-zasuvka-okruhle-zrkadlo-01.jpg')}
          alt="Predsieň s lamelovou stenou a závesnou zásuvkou v dekore dub"
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 45vw, 100vw"
          class="aspect-[4/5] w-full object-cover"
        />
      </div>

      <div class="glass-card absolute -bottom-8 -left-4 max-w-[17rem] p-5 sm:-left-12">
        <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-walnut text-oak">
          <Icon name="saw" size={20} />
        </span>
        <p class="mt-3 font-semibold">Vlastná dielňa v Gbeloch</p>
        <p class="mt-1 text-sm leading-relaxed text-stone">Vyrábame sami, bez sprostredkovateľov.</p>
      </div>

      <div class="glass-card absolute top-8 -right-3 flex items-center gap-3 p-3 pr-5 sm:-right-8">
        <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-copper text-white">
          <Icon name="ruler" size={19} />
        </span>
        <span class="text-sm leading-tight">
          <b class="block">Na centimeter</b>
          <span class="text-stone">zameriame aj montujeme</span>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .glass-card {
    border-radius: 1.5rem;
    background: rgb(255 255 255 / 0.74);
    backdrop-filter: blur(16px) saturate(1.3);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.8),
      0 24px 50px -24px rgb(29 26 23 / 0.45);
  }
</style>

---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import FoldingRuler from '../FoldingRuler.astro';
import { photo } from '../../lib/images';
import { site } from '../../data/site';

const prints = [
  { src: 'kuchyne/kuchyna-dub-ostrov-00-hero-sirka.jpg', label: 'Kuchyňa s ostrovom', rot: '-8deg', x: '0%', y: '4%' },
  { src: 'obyvacky/tv-stena-lamely-policova-skrina-01-sirka-web.jpg', label: 'TV stena s lamelami', rot: '6deg', x: '28%', y: '0%' },
  { src: 'detske-izby/poschodova-postel-schody-zasuvky-02-sirka.jpg', label: 'Poschodová posteľ', rot: '-1.5deg', x: '12%', y: '40%' },
];
---

<section id="navrh" class="sheet !bg-cream overflow-x-clip pt-24 pb-28 lg:pt-28 lg:pb-36">
  <span class="sheet-notch"><Icon name="arrow" size={16} class="rotate-90" /></span>

  <div class="container-x grid items-center gap-16 lg:grid-cols-[1fr_1.05fr] lg:gap-10">
    <div data-reveal>
      <svg class="h-12 w-14 text-copper/35" viewBox="0 0 56 48" fill="currentColor" aria-hidden="true"><path d="M0 48V28C0 12 8 3 22 0l3 7c-8 3-12 9-12 16h11v25zm31 0V28C31 12 39 3 53 0l3 7c-8 3-12 9-12 16h11v25z"/></svg>
      <h2 class="mt-5 text-4xl leading-[1.02] font-semibold sm:text-5xl">Návrh a cena</h2>
      <p class="mt-3 text-xl text-stone">
        – pre váš priestor, <strong class="font-semibold text-ink">bez záväzkov</strong>
      </p>

      <p class="mt-8 font-medium">Nechajte nám číslo a my vám:</p>
      <ul class="mt-4 space-y-3">
        {
          ['zavoláme a prejdeme vašu predstavu', 'dohodneme termín zamerania', 'pripravíme návrh a cenovú ponuku'].map(
            (t) => (
              <li class="flex items-center gap-3 text-stone">
                <Icon name="check" size={18} class="text-copper" />
                {t}
              </li>
            ),
          )
        }
      </ul>

      <form
        data-web3
        data-key={site.web3formsKey}
        class="mt-9 max-w-lg rounded-[1.5rem] bg-white p-5 shadow-[0_24px_50px_-30px_rgba(29,26,23,0.5)] ring-1 ring-line sm:p-6"
        novalidate
      >
        <p class="text-center font-semibold">Zadajte telefónne číslo</p>
        <input type="hidden" name="subject" value="Žiadosť o zavolanie – web JUTRSTOL" />
        <input type="hidden" name="from_name" value="Web JUTRSTOL" />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <label class="relative block">
            <span class="sr-only">Vaše meno</span>
            <input id="cb-name" name="name" required autocomplete="name" class="field" placeholder="Vaše meno" />
          </label>
          <label class="relative block">
            <span class="sr-only">Telefón</span>
            <input
              id="cb-phone"
              name="phone"
              type="tel"
              required
              autocomplete="tel"
              class="field"
              placeholder="Telefón"
            />
          </label>
        </div>
        <label class="mt-3 flex items-start gap-2.5 text-xs text-stone">
          <input id="cb-gdpr" type="checkbox" name="gdpr" required class="mt-0.5 h-4 w-4 shrink-0 accent-copper" />
          <span
            >Súhlasím so spracovaním údajov podľa{' '}
            <a href="/ochrana-osobnych-udajov" class="underline decoration-oak underline-offset-2">zásad ochrany</a>.</span
          >
        </label>
        <p data-status role="status" aria-live="polite" class="hidden"></p>
        <div class="-mb-10 mt-5 flex justify-center">
          <button type="submit" class="btn-primary flex-col !gap-0 !px-8 !py-3">
            <span class="flex items-center gap-2 text-[15px]">Zavolajte mi <Icon name="phone" size={16} /></span>
            <span class="text-xs font-normal text-white/75">ozveme sa čo najskôr</span>
          </button>
        </div>
      </form>
    </div>

    <div class="relative mx-auto aspect-[5/4] w-full max-w-xl" data-reveal style="--d:120ms" aria-hidden="true">
      {
        prints.map((p) => (
          <figure
            class="print absolute w-[66%] rounded-md bg-white p-2.5 pb-9 shadow-[0_30px_50px_-20px_rgba(29,26,23,0.55)] transition duration-700"
            style={`left:${p.x};top:${p.y};--r:${p.rot}`}
          >
            <Image src={photo(p.src)} alt="" widths={[400, 640]} sizes="(min-width: 1024px) 30vw, 70vw" class="aspect-[4/3] w-full object-cover" />
            <figcaption class="script absolute bottom-1 left-4 text-2xl text-ink/80">{p.label}</figcaption>
          </figure>
        ))
      }
      <FoldingRuler class="pointer-events-none absolute -right-6 -bottom-16 w-72 rotate-[-18deg] sm:w-80" angles={[0, 165]} start={40} />
    </div>
  </div>
</section>

<style>
  .print {
    transform: rotate(var(--r));
  }
  .print:hover {
    transform: rotate(0deg) scale(1.03);
    z-index: 5;
  }
</style>

<script>
  import { bindForms } from '../../scripts/forms';
  bindForms();
</script>

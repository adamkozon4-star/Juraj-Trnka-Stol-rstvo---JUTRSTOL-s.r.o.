---
// Konfigurátor skrine na mieru: živý nákres s kótami, orientačná cena a odoslanie návrhu na ponuku.
import Icon from './Icon.astro';
import { configurator as cfg } from '../data/configurator';
import { site } from '../data/site';

const L = cfg.limits;
---

<div id="cfg" class="cfg grid gap-6 lg:grid-cols-[1.2fr_1fr] lg:gap-8">
  <script type="application/json" id="cfg-data" set:html={JSON.stringify(cfg)} />

  <!-- Náhľad -->
  <div class="lg:sticky lg:top-28 lg:self-start">
    <div class="glass relative overflow-hidden rounded-[2rem] p-4 sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm font-semibold">Náhľad skrine</p>
        <div class="seg" role="tablist" aria-label="Pohľad na skriňu">
          <button type="button" role="tab" data-view="doors" aria-selected="true">S dverami</button>
          <button type="button" role="tab" data-view="inside" aria-selected="false">Vnútro</button>
        </div>
      </div>
      <div class="cfg-stage mt-4 rounded-[1.4rem]">
        <svg id="cfg-svg" class="h-auto w-full" role="img" aria-label="Nákres skrine podľa zvolených parametrov"></svg>
      </div>
      <ul id="cfg-chips" class="mt-4 flex flex-wrap gap-2 text-[13px]"></ul>
    </div>

    {
      cfg.showPrice && (
        <div class="price-card mt-4 flex flex-col gap-2 rounded-[1.6rem] bg-walnut p-5 text-white sm:flex-row sm:items-end sm:justify-between sm:gap-4 sm:p-6">
          <div>
            <p class="text-xs font-semibold tracking-[0.16em] text-oak uppercase">Orientačná cena</p>
            <p id="cfg-price" class="mt-1 font-display text-3xl font-semibold tabular-nums sm:text-4xl">–</p>
          </div>
          <p class="text-xs leading-relaxed text-white/60 sm:max-w-[13rem] sm:text-right">
            Bez montáže a dopravy. Presnú cenu potvrdíme po zameraní.
          </p>
        </div>
      )
    }
  </div>

  <!-- Voľby -->
  <form id="cfg-form" data-web3 data-key={site.web3formsKey} class="flex flex-col gap-4" novalidate>
    <input type="hidden" name="subject" value="Konfigurátor skrine – nový návrh z webu" />
    <input type="hidden" name="from_name" value="Web JUTRSTOL – konfigurátor" />
    <input type="hidden" name="type" value="Konfigurátor – skriňa na mieru" />
    <input type="hidden" name="konfiguracia" id="cfg-summary" />
    <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

    <fieldset class="glass step">
      <legend class="step-title"><span>1</span> Rozmery</legend>
      <div class="grid gap-5">
        {
          (
            [
              ['width', 'Šírka', L.width],
              ['height', 'Výška', L.height],
              ['depth', 'Hĺbka', L.depth],
            ] as const
          ).map(([key, label, lim]) => (
            <div class="dim">
              <label for={`cfg-${key}`} class="text-sm font-medium">
                {label}
              </label>
              <input
                type="range"
                id={`cfg-${key}-range`}
                data-dim={key}
                min={lim.min}
                max={lim.max}
                step={lim.step}
                value={lim.default}
                aria-label={`${label} v cm`}
              />
              <span class="dim-num">
                <input
                  type="number"
                  id={`cfg-${key}`}
                  data-dim={key}
                  min={lim.min}
                  max={lim.max}
                  step={lim.step}
                  value={lim.default}
                  inputmode="numeric"
                />
                cm
              </span>
            </div>
          ))
        }
      </div>
    </fieldset>

    <fieldset class="glass step">
      <legend class="step-title"><span>2</span> Dvere a úchytky</legend>
      <div class="grid gap-2 sm:grid-cols-3">
        {
          cfg.doors.map((d, i) => (
            <label class="opt">
              <input type="radio" name="cfg-door" value={d.id} checked={i === 0} class="sr-only" />
              <span class="opt-body">
                <b>{d.label}</b>
                <small>{d.note}</small>
              </span>
            </label>
          ))
        }
      </div>
      <div id="cfg-handles" class="mt-3 grid gap-2 sm:grid-cols-3">
        {
          cfg.handles.map((h, i) => (
            <label class="opt opt-sm">
              <input type="radio" name="cfg-handle" value={h.id} checked={i === 0} class="sr-only" />
              <span class="opt-body">
                <b>{h.label}</b>
                <small>{h.note}</small>
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset class="glass step">
      <legend class="step-title"><span>3</span> Dekor</legend>
      <div class="grid grid-cols-3 gap-2 sm:grid-cols-6">
        {
          cfg.decors.map((d, i) => (
            <label class="swatch" title={d.label}>
              <input type="radio" name="cfg-decor" value={d.id} checked={i === 2} class="sr-only" />
              <span
                class="swatch-chip"
                style={`background:${d.fill};${d.grain ? `background-image:repeating-linear-gradient(95deg,rgba(0,0,0,.07) 0 1px,transparent 1px 7px);` : ''}`}
              />
              <span class="swatch-label">{d.label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset class="glass step">
      <legend class="step-title"><span>4</span> Vnútro sekcií</legend>
      <p class="-mt-1 mb-3 text-sm text-stone">
        Skriňu sme rozdelili na <b id="cfg-count" class="text-ink">3</b> sekcie. Vyberte, čo má byť v každej.
      </p>
      <div id="cfg-sections" class="grid gap-2 sm:grid-cols-2"></div>
    </fieldset>

    <fieldset class="glass step">
      <legend class="step-title"><span>5</span> Doplnky</legend>
      <div class="grid gap-2">
        {
          cfg.extras.map((x) => (
            <label class:list={['check', 'locked' in x && x.locked && 'is-locked']}>
              <input
                type="checkbox"
                name="cfg-extra"
                value={x.id}
                checked={'checked' in x && x.checked}
                disabled={'locked' in x && x.locked}
              />
              <span class="flex-1">{x.label}</span>
              <small class="text-stone">{'note' in x ? x.note : `+ ${x.price} ${cfg.currency}`}</small>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset class="glass step">
      <legend class="step-title"><span>6</span> Kam vám pošleme ponuku</legend>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium">Meno a priezvisko *</span>
          <input id="cfg-name" name="name" required autocomplete="name" class="field" placeholder="Ján Novák" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium">Telefón *</span>
          <input id="cfg-phone" name="phone" type="tel" required autocomplete="tel" class="field" placeholder="09xx xxx xxx" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium">E-mail</span>
          <input id="cfg-email" name="email" type="email" autocomplete="email" class="field" placeholder="vas@email.sk" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium">Mesto / obec</span>
          <input id="cfg-city" name="city" autocomplete="address-level2" class="field" placeholder="Gbely" />
        </label>
      </div>
      <label class="mt-3 block">
        <span class="mb-1.5 block text-sm font-medium">Poznámka</span>
        <textarea
          id="cfg-note"
          name="message"
          rows="3"
          class="field resize-y"
          placeholder="Napr. skriňa do spálne pod šikminu, termín na jar…"></textarea>
      </label>
      <label class="mt-3 flex items-start gap-3 text-sm text-stone">
        <input id="cfg-gdpr" type="checkbox" name="gdpr" required class="mt-0.5 h-5 w-5 shrink-0 accent-copper" />
        <span
          >Súhlasím so spracovaním osobných údajov podľa{' '}
          <a href="/ochrana-osobnych-udajov" class="underline decoration-oak underline-offset-2">zásad ochrany</a>. *</span
        >
      </label>
      <button type="submit" class="btn-primary mt-5 w-full !py-4 text-base">
        Poslať návrh a získať ponuku <Icon name="arrow" size={18} />
      </button>
      <p data-status role="status" aria-live="polite" class="hidden"></p>
    </fieldset>
  </form>
</div>

<style>
  .glass {
    background: rgb(255 255 255 / 0.62);
    backdrop-filter: blur(18px) saturate(1.3);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.7) inset,
      0 0 0 1px rgb(29 26 23 / 0.06),
      0 24px 50px -32px rgb(29 26 23 / 0.35);
  }
  .step {
    border-radius: 1.6rem;
    padding: 1.25rem;
  }
  @media (min-width: 640px) {
    .step {
      padding: 1.5rem;
    }
  }
  .step-title {
    float: left;
    width: 100%;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
  }
  .step-title + * {
    clear: both;
  }
  .step-title span {
    display: inline-flex;
    width: 1.6rem;
    height: 1.6rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--color-walnut);
    color: var(--color-oak);
    font-size: 0.75rem;
  }
  .cfg-stage {
    background:
      linear-gradient(rgb(29 26 23 / 0.045) 1px, transparent 1px) 0 0 / 20px 20px,
      linear-gradient(90deg, rgb(29 26 23 / 0.045) 1px, transparent 1px) 0 0 / 20px 20px,
      radial-gradient(120% 90% at 50% 0%, #fff, #efe9e1);
    box-shadow: inset 0 0 0 1px rgb(29 26 23 / 0.06);
  }
  .seg {
    display: inline-flex;
    gap: 2px;
    border-radius: 999px;
    background: rgb(29 26 23 / 0.06);
    padding: 3px;
  }
  .seg button {
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-stone);
    transition: all 0.2s;
  }
  .seg button[aria-selected='true'] {
    background: white;
    color: var(--color-ink);
    box-shadow: 0 2px 8px -2px rgb(29 26 23 / 0.25);
  }
  .dim {
    display: grid;
    grid-template-columns: 4.2rem 1fr auto;
    align-items: center;
    gap: 0.9rem;
  }
  .dim input[type='range'] {
    accent-color: var(--color-copper);
    width: 100%;
  }
  .dim-num {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--color-stone);
  }
  .dim-num input {
    width: 4.2rem;
    border-radius: 0.7rem;
    border: 1px solid var(--color-line);
    background: white;
    padding: 0.4rem 0.5rem;
    text-align: right;
    font-weight: 600;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .opt {
    cursor: pointer;
  }
  .opt-body {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 0.2rem;
    border-radius: 1rem;
    background: white;
    padding: 0.8rem 0.9rem;
    box-shadow: inset 0 0 0 1px var(--color-line);
    transition: all 0.2s;
  }
  .opt-body b {
    font-size: 0.92rem;
    font-weight: 600;
  }
  .opt-body small {
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--color-stone);
  }
  .opt-sm .opt-body {
    padding: 0.6rem 0.8rem;
  }
  .opt input:checked + .opt-body {
    box-shadow:
      inset 0 0 0 2px var(--color-copper),
      0 8px 20px -12px rgb(196 115 58 / 0.7);
  }
  .opt input:focus-visible + .opt-body,
  .swatch input:focus-visible + .swatch-chip {
    outline: 2px solid var(--color-copper);
    outline-offset: 2px;
  }
  #cfg-handles.is-disabled {
    opacity: 0.4;
    pointer-events: none;
  }
  .swatch {
    display: flex;
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-align: center;
  }
  .swatch-chip {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 1rem;
    box-shadow:
      inset 0 0 0 1px rgb(29 26 23 / 0.12),
      0 6px 14px -8px rgb(29 26 23 / 0.5);
    transition: transform 0.2s;
  }
  .swatch input:checked + .swatch-chip {
    box-shadow:
      0 0 0 3px white,
      0 0 0 5px var(--color-copper),
      0 10px 20px -10px rgb(29 26 23 / 0.6);
    transform: translateY(-2px);
  }
  .swatch-label {
    font-size: 0.72rem;
    line-height: 1.2;
    color: var(--color-stone);
  }
  .check {
    display: flex;
    cursor: pointer;
    align-items: center;
    gap: 0.75rem;
    border-radius: 1rem;
    background: white;
    padding: 0.75rem 0.9rem;
    font-size: 0.92rem;
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .check input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--color-copper);
  }
  .check.is-locked {
    cursor: default;
    opacity: 0.75;
  }
  :global(.sec-row) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border-radius: 1rem;
    background: white;
    padding: 0.45rem 0.45rem 0.45rem 0.75rem;
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  :global(.sec-row b) {
    display: inline-flex;
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--color-apricot);
    color: var(--color-copper-dark);
    font-size: 0.75rem;
  }
  :global(.sec-row select) {
    flex: 1;
    min-width: 0;
    border: 0;
    border-radius: 0.7rem;
    background: var(--color-cream);
    padding: 0.5rem 0.6rem;
    font-size: 0.85rem;
    color: var(--color-ink);
  }
  :global(#cfg-chips li) {
    border-radius: 999px;
    background: white;
    padding: 0.3rem 0.75rem;
    color: var(--color-stone);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  :global(#cfg-chips li b) {
    color: var(--color-ink);
    font-weight: 600;
  }
</style>

<script>
  import { initConfigurator } from '../scripts/configurator';
  document.addEventListener('astro:page-load', initConfigurator);
</script>

---
// Plochá stolárska ceruzka so zastrúhaným hrotom (SVG, vodorovne – natočenie cez CSS).
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg class={className} viewBox="0 0 420 44" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="pencil-body" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e36a3a"></stop>
      <stop offset=".45" stop-color="#c9482a"></stop>
      <stop offset="1" stop-color="#8f2d1a"></stop>
    </linearGradient>
    <linearGradient id="pencil-wood" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f3d6a6"></stop>
      <stop offset="1" stop-color="#cfa46a"></stop>
    </linearGradient>
    <filter id="pencil-shadow" x="-5%" y="-40%" width="110%" height="200%">
      <feDropShadow dx="0" dy="9" stdDeviation="7" flood-color="#1d1a17" flood-opacity="0.3"></feDropShadow>
    </filter>
  </defs>
  <g filter="url(#pencil-shadow)">
    <rect x="6" y="8" width="330" height="28" rx="3" fill="url(#pencil-body)"></rect>
    <rect x="6" y="8" width="330" height="5" rx="2" fill="#fff" fill-opacity=".18"></rect>
    <rect x="6" y="30" width="330" height="6" rx="2" fill="#000" fill-opacity=".12"></rect>
    <path d="M336 8 L400 20 L400 24 L336 36 Z" fill="url(#pencil-wood)"></path>
    <path d="M336 8 L352 11 L352 33 L336 36 Z" fill="#000" fill-opacity=".06"></path>
    <path d="M384 17 L414 21 Q416 22 414 23 L384 27 Z" fill="#3a3632"></path>
    <text
      x="40"
      y="27"
      font-family="Arial, sans-serif"
      font-size="11"
      font-weight="700"
      letter-spacing="3"
      fill="#fff"
      fill-opacity=".8">JUTRSTOL · GBELY</text
    >
    <text x="250" y="27" font-family="Arial, sans-serif" font-size="10" font-weight="700" fill="#fff" fill-opacity=".6"
      >HB</text
    >
  </g>
</svg>

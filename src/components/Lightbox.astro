---
import Icon from './Icon.astro';
// Lightbox pre odkazy s atribútom [data-lightbox="skupina"] a href na veľkú fotku.
---

<dialog
  id="lightbox"
  class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-[#140f0c]/95 backdrop:backdrop-blur-sm"
  aria-label="Galéria fotiek"
>
  <div class="relative flex h-full w-full items-center justify-center">
    <figure class="flex h-full w-full flex-col items-center justify-center px-3 pt-16 pb-24 sm:px-20">
      <img id="lb-img" alt="" class="max-h-full max-w-full rounded-lg object-contain shadow-2xl transition-opacity duration-300" />
      <figcaption id="lb-caption" class="mt-4 text-center text-sm text-white/70"></figcaption>
    </figure>

    <span id="lb-count" class="absolute top-5 left-5 text-sm font-medium text-white/70 tabular-nums"></span>
    <button
      type="button"
      data-lb="close"
      class="absolute top-3 right-3 inline-flex h-12 w-12 items-center justify-center rounded-full text-white transition hover:bg-white/10"
      aria-label="Zavrieť"
    >
      <Icon name="close" size={26} />
    </button>
    <button
      type="button"
      data-lb="prev"
      class="absolute bottom-6 left-1/2 inline-flex h-12 w-12 -translate-x-[calc(100%+8px)] items-center justify-center rounded-full bg-white/10 text-white ring-1 ring-white/15 transition hover:bg-copper sm:top-1/2 sm:bottom-auto sm:left-5 sm:-translate-x-0 sm:-translate-y-1/2"
      aria-label="Predchádzajúca fotka"
    >
      <Icon name="arrowLeft" size={22} />
    </button>
    <button
      type="button"
      data-lb="next"
      class="absolute right-1/2 bottom-6 inline-flex h-12 w-12 translate-x-[calc(100%+8px)] items-center justify-center rounded-full bg-white/10 text-white ring-1 ring-white/15 transition hover:bg-copper sm:top-1/2 sm:right-5 sm:bottom-auto sm:translate-x-0 sm:-translate-y-1/2"
      aria-label="Ďalšia fotka"
    >
      <Icon name="arrow" size={22} />
    </button>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lb-img') as HTMLImageElement;
  const caption = document.getElementById('lb-caption')!;
  const count = document.getElementById('lb-count')!;
  let items: HTMLAnchorElement[] = [];
  let index = 0;

  const render = () => {
    const a = items[index];
    img.style.opacity = '0';
    img.onload = () => (img.style.opacity = '1');
    img.src = a.href;
    img.alt = a.dataset.caption ?? '';
    caption.textContent = a.dataset.caption ?? '';
    count.textContent = `${index + 1} / ${items.length}`;
    // prednačítanie ďalšej
    const next = items[(index + 1) % items.length];
    if (next) new Image().src = next.href;
  };
  const go = (step: number) => {
    index = (index + step + items.length) % items.length;
    render();
  };

  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-lightbox]');
    if (!a) return;
    e.preventDefault();
    items = [...document.querySelectorAll<HTMLAnchorElement>(`a[data-lightbox="${a.dataset.lightbox}"]`)];
    index = items.indexOf(a);
    render();
    dialog.showModal();
    document.documentElement.style.overflow = 'hidden';
  });

  dialog.addEventListener('close', () => (document.documentElement.style.overflow = ''));
  dialog.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const action = t.closest<HTMLElement>('[data-lb]')?.dataset.lb;
    if (action === 'close') dialog.close();
    else if (action === 'prev') go(-1);
    else if (action === 'next') go(1);
    else if (t.tagName === 'FIGURE' || t === dialog) dialog.close();
  });
  document.addEventListener('keydown', (e) => {
    if (!dialog.open) return;
    if (e.key === 'ArrowLeft') go(-1);
    if (e.key === 'ArrowRight') go(1);
  });

  // Swipe na mobile
  let startX = 0;
  dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
  dialog.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) go(dx < 0 ? 1 : -1);
  });
</script>

---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  tone?: 'dark' | 'light';
  as?: 'h1' | 'h2';
}
const { eyebrow, title, lead, align = 'left', tone = 'dark', as: Tag = 'h2' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']} data-reveal>
  <p class:list={['eyebrow', align === 'center' && 'justify-center', tone === 'light' && 'eyebrow-dark']}>{eyebrow}</p>
  <Tag
    class:list={[
      'mt-5 text-4xl leading-[1.02] font-semibold sm:text-5xl',
      tone === 'light' ? 'text-white' : 'text-ink',
    ]}
    set:html={title}
  />
  {
    lead && (
      <p class:list={['mt-5 text-lg leading-relaxed', tone === 'light' ? 'text-white/70' : 'text-stone']}>{lead}</p>
    )
  }
</div>

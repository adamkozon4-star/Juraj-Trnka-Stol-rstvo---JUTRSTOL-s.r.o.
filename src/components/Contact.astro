---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import InquiryForm from './InquiryForm.astro';
import { site, telHref, fullAddress } from '../data/site';
import woodSlice from '../assets/dekor/drevo-letokruhy.webp';
import fan from '../assets/dekor/vejar-dekorov.webp';

interface Props {
  preselect?: string; // názov kategórie, ktorá sa predvyberie vo formulári
}
const { preselect } = Astro.props;
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${site.address.street}, ${site.address.zip} ${site.address.city}, Slovensko`,
)}`;
---

<section
  id="kontakt"
  data-nav="Kontakt"
  class="sheet contact-bg relative overflow-x-clip pt-24 pb-28 lg:pt-28 lg:pb-36"
>
  <!-- Rez kmeňom prečnieva cez pravý okraj ako na plagáte -->
  <Image
    src={woodSlice}
    alt=""
    widths={[480, 800]}
    sizes="44rem"
    class="slice pointer-events-none absolute top-1/2 -right-[22rem] hidden w-[44rem] -translate-y-1/2 lg:block xl:-right-[18rem]"
  />
  <!-- Veľké zvislé slovo v pozadí -->
  <p class="giant pointer-events-none absolute top-20 left-4 hidden font-display font-semibold select-none xl:block" aria-hidden="true">
    NA MIERU
  </p>

  <div class="container-x relative grid gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div class="lg:pt-6">
      <div data-reveal>
        <p class="eyebrow">Kontakt</p>
        <h2 class="mt-5 text-4xl leading-[1.02] font-semibold sm:text-5xl lg:text-6xl">
          Máte predstavu?
          <span class="script mt-1 block text-copper">poďme ju vyrobiť</span>
        </h2>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-stone">
          Napíšte nám pár slov o tom, čo potrebujete. Ozveme sa, dohodneme zameranie a pripravíme nezáväznú cenovú
          ponuku.
        </p>
      </div>

      <a
        href={telHref}
        class="group mt-10 flex items-center gap-5 rounded-[1.75rem] bg-walnut p-5 pr-6 text-white shadow-[0_30px_60px_-30px_rgba(29,26,23,0.7)] transition hover:-translate-y-0.5"
        data-reveal
        style="--d:80ms"
      >
        <span class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-b from-[#d9894d] to-copper">
          <Icon name="phone" size={24} />
        </span>
        <span class="flex-1">
          <span class="block text-xs font-semibold tracking-[0.16em] text-oak uppercase">Zavolajte priamo Jurajovi</span>
          <span class="mt-0.5 block font-display text-3xl font-semibold tabular-nums">{site.phoneDisplay}</span>
        </span>
        <Icon name="arrow" size={20} class="text-oak transition group-hover:translate-x-1" />
      </a>

      <div class="mt-4 grid gap-3 sm:grid-cols-2" data-reveal style="--d:140ms">
        <a href={mapsHref} target="_blank" rel="noopener" class="info-card group">
          <span class="info-icon"><Icon name="pin" size={20} /></span>
          <span class="block text-xs font-semibold tracking-[0.14em] text-stone uppercase">Dielňa</span>
          <span class="mt-1 block font-semibold">{site.address.street}</span>
          <span class="block text-stone">{site.address.zip} {site.address.city}</span>
          <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-copper">
            Otvoriť mapu <Icon name="arrow" size={14} class="transition group-hover:translate-x-0.5" />
          </span>
        </a>
        {
          site.email ? (
            <a href={`mailto:${site.email}`} class="info-card group">
              <span class="info-icon">
                <Icon name="mail" size={20} />
              </span>
              <span class="block text-xs font-semibold tracking-[0.14em] text-stone uppercase">E-mail</span>
              <span class="mt-1 block font-semibold break-all">{site.email}</span>
              <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-copper">
                Napísať <Icon name="arrow" size={14} />
              </span>
            </a>
          ) : (
            <a href={site.facebook} target="_blank" rel="noopener" class="info-card group">
              <span class="info-icon">
                <Icon name="facebook" size={20} />
              </span>
              <span class="block text-xs font-semibold tracking-[0.14em] text-stone uppercase">Facebook</span>
              <span class="mt-1 block font-semibold">JuTrStol</span>
              <span class="block text-stone">novinky a realizácie</span>
              <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-copper">
                Sledovať <Icon name="arrow" size={14} class="transition group-hover:translate-x-0.5" />
              </span>
            </a>
          )
        }
      </div>
      {site.openingHours && <p class="mt-4 text-sm text-stone">Otváracie hodiny: {site.openingHours}</p>}
      <p class="sr-only">Adresa: {fullAddress}</p>

      <!-- Vzorky dekorov s ručne písaným popisom -->
      <figure class="samples relative mt-14 hidden items-center gap-2 lg:flex" data-reveal style="--d:200ms" aria-hidden="true">
        <Image src={fan} alt="" widths={[300, 520]} sizes="15rem" class="fan w-52 shrink-0 xl:w-60" />
        <figcaption class="relative -mt-16 ml-4 max-w-[13rem]">
          <svg class="absolute top-3 -left-14 h-12 w-12 text-copper/70" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M44 6C30 6 16 14 10 34" />
            <path d="M4 27l6 8 8-5" />
          </svg>
          <span class="script block text-[1.9rem] leading-[1.05] text-copper">dekory si vyberiete zo vzoriek</span>
          <span class="mt-2 block text-sm text-stone">Desiatky odtieňov dreva, betónu aj jednofarebných.</span>
        </figcaption>
      </figure>
    </div>

    <div class="relative" data-reveal style="--d:120ms">
      <InquiryForm preselect={preselect} />
      <a
        href="/konfigurator"
        class="group mt-4 flex items-center gap-4 rounded-[1.5rem] bg-white/60 p-5 ring-1 ring-white/80 backdrop-blur transition hover:bg-white/80"
      >
        <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-walnut text-oak"
          ><Icon name="cube" size={22} /></span
        >
        <span class="flex-1">
          <span class="block font-semibold">Navrhnite si nábytok online</span>
          <span class="block text-sm text-stone">Kuchyňa, skriňa či šatník v konfigurátore.</span>
        </span>
        <Icon name="arrow" size={18} class="text-copper transition group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</section>

<style>
  .contact-bg {
    background:
      radial-gradient(50rem 30rem at 85% 50%, rgb(255 255 255 / 0.55), transparent 70%),
      linear-gradient(160deg, #f3e6d6 0%, #ecdac5 55%, #e6d0b8 100%) !important;
  }
  .slice {
    filter: drop-shadow(0 40px 50px rgb(80 45 20 / 0.35));
    animation: slice-spin 120s linear infinite;
  }
  @keyframes slice-spin {
    to {
      rotate: 360deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .slice {
      animation: none;
    }
  }
  .fan {
    transform: rotate(-12deg) scaleX(-1);
    filter: drop-shadow(0 26px 30px rgb(80 45 20 / 0.35));
    transition: transform 0.8s var(--ease-out-soft);
  }
  .samples:hover .fan {
    transform: rotate(-4deg) scaleX(-1);
  }
  .giant {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 9rem;
    line-height: 0.8;
    letter-spacing: -0.02em;
    color: rgb(196 115 58 / 0.13);
  }
  .info-card {
    position: relative;
    display: block;
    border-radius: 1.5rem;
    background: rgb(255 255 255 / 0.62);
    padding: 1.25rem 1.25rem 1.1rem 4.4rem;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.8),
      0 20px 40px -28px rgb(80 45 20 / 0.5);
    backdrop-filter: blur(12px);
    transition:
      transform 0.3s,
      background 0.3s;
  }
  .info-card:hover {
    transform: translateY(-2px);
    background: rgb(255 255 255 / 0.8);
  }
  .info-icon {
    position: absolute;
    top: 1.2rem;
    left: 1.2rem;
    display: inline-flex;
    width: 2.4rem;
    height: 2.4rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.9rem;
    background: var(--color-walnut);
    color: var(--color-oak);
  }
</style>

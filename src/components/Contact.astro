---
import Icon from './Icon.astro';
import InquiryForm from './InquiryForm.astro';
import { site, telHref, fullAddress } from '../data/site';

interface Props {
  preselect?: string; // názov kategórie, ktorá sa predvyberie vo formulári
}
const { preselect } = Astro.props;
const mapQuery = encodeURIComponent(`${site.address.street}, ${site.address.zip} ${site.address.city}, Slovensko`);
---

<section id="kontakt" data-nav="Kontakt" class="sheet sheet-dark !bg-walnut pt-24 pb-28 text-white lg:pt-28 lg:pb-32">

  <div class="container-x grid gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
    <div>
      <div data-reveal>
        <p class="eyebrow eyebrow-dark">Kontakt</p>
        <h2 class="mt-5 text-4xl leading-[1.08] font-medium sm:text-5xl">
          Máte predstavu? Poďme ju vyrobiť.
        </h2>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-white/70">
          Napíšte nám pár slov o tom, čo potrebujete. Ozveme sa, dohodneme zameranie a pripravíme nezáväznú cenovú
          ponuku.
        </p>
      </div>

      <ul class="mt-10 space-y-3" data-reveal style="--d:100ms">
        <li>
          <a
            href={telHref}
            class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-5 transition hover:border-oak/50"
          >
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-copper text-white">
              <Icon name="phone" size={22} />
            </span>
            <span>
              <span class="block text-xs tracking-[0.18em] text-white/50 uppercase">Telefón</span>
              <span class="block text-xl font-semibold group-hover:text-oak">{site.phoneDisplay}</span>
            </span>
          </a>
        </li>
        {
          site.email && (
            <li>
              <a
                href={`mailto:${site.email}`}
                class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-5 transition hover:border-oak/50"
              >
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 text-oak">
                  <Icon name="mail" size={22} />
                </span>
                <span>
                  <span class="block text-xs tracking-[0.18em] text-white/50 uppercase">E-mail</span>
                  <span class="block text-lg font-semibold group-hover:text-oak">{site.email}</span>
                </span>
              </a>
            </li>
          )
        }
        <li class="flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-5">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 text-oak">
            <Icon name="pin" size={22} />
          </span>
          <span>
            <span class="block text-xs tracking-[0.18em] text-white/50 uppercase">Dielňa</span>
            <span class="block text-lg font-semibold">{fullAddress}</span>
          </span>
        </li>
        <li>
          <a
            href={site.facebook}
            target="_blank"
            rel="noopener"
            class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-5 transition hover:border-oak/50"
          >
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 text-oak">
              <Icon name="facebook" size={22} />
            </span>
            <span>
              <span class="block text-xs tracking-[0.18em] text-white/50 uppercase">Facebook</span>
              <span class="block text-lg font-semibold group-hover:text-oak">facebook.com/JuTrStol</span>
            </span>
          </a>
        </li>
      </ul>

      <div class="mt-6 overflow-hidden rounded-2xl ring-1 ring-white/10" data-reveal style="--d:160ms">
        <iframe
          title="Mapa – JUTRSTOL, Gbely"
          src={`https://maps.google.com/maps?q=${mapQuery}&z=15&output=embed`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="h-56 w-full grayscale-[0.4] sepia-[0.15]"></iframe>
      </div>
    </div>

    <div data-reveal style="--d:120ms">
      <InquiryForm preselect={preselect} />
      <a
        href="/konfigurator"
        class="group mt-4 flex items-center gap-4 rounded-[1.5rem] bg-white/[0.06] p-5 ring-1 ring-white/10 transition hover:bg-white/[0.1]"
      >
        <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-oak/15 text-oak"><Icon name="cube" size={22} /></span>
        <span class="flex-1">
          <span class="block font-semibold">Chcete skriňu? Navrhnite si ju sami</span>
          <span class="block text-sm text-white/60">V konfigurátore uvidíte nákres aj orientačnú cenu.</span>
        </span>
        <Icon name="arrow" size={18} class="text-oak transition group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</section>



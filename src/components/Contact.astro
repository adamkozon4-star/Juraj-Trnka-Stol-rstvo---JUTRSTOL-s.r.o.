---
import Icon from './Icon.astro';
import { site, telHref, fullAddress } from '../data/site';
import { categories } from '../data/categories';

interface Props {
  preselect?: string; // názov kategórie, ktorá sa predvyberie vo formulári
}
const { preselect } = Astro.props;
const mapQuery = encodeURIComponent(`${site.address.street}, ${site.address.zip} ${site.address.city}, Slovensko`);
---

<section id="kontakt" class="sheet wood-grain !bg-walnut pt-24 pb-28 text-white lg:pt-28 lg:pb-32">
  <span class="sheet-notch"><Icon name="arrow" size={16} class="rotate-90" /></span>

  <div class="container-x grid gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
    <div>
      <div data-reveal>
        <p class="eyebrow eyebrow-dark">Kontakt</p>
        <h2 class="mt-5 text-4xl leading-[1.08] font-medium sm:text-5xl">
          Máte predstavu? Poďme ju vyrobiť.
        </h2>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-white/70">
          Napíšte nám pár slov o tom, čo potrebujete. Ozveme sa, dohodneme zameranie a pripravíme nezáväznú cenovú
          ponuku.
        </p>
      </div>

      <ul class="mt-10 space-y-3" data-reveal style="--d:100ms">
        <li>
          <a
            href={telHref}
            class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-5 transition hover:border-oak/50"
          >
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-copper text-white">
              <Icon name="phone" size={22} />
            </span>
            <span>
              <span class="block text-xs tracking-[0.18em] text-white/50 uppercase">Telefón</span>
              <span class="block text-xl font-semibold group-hover:text-oak">{site.phoneDisplay}</span>
            </span>
          </a>
        </li>
        {
          site.email && (
            <li>
              <a
                href={`mailto:${site.email}`}
                class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-5 transition hover:border-oak/50"
              >
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 text-oak">
                  <Icon name="mail" size={22} />
                </span>
                <span>
                  <span class="block text-xs tracking-[0.18em] text-white/50 uppercase">E-mail</span>
                  <span class="block text-lg font-semibold group-hover:text-oak">{site.email}</span>
                </span>
              </a>
            </li>
          )
        }
        <li class="flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-5">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 text-oak">
            <Icon name="pin" size={22} />
          </span>
          <span>
            <span class="block text-xs tracking-[0.18em] text-white/50 uppercase">Dielňa</span>
            <span class="block text-lg font-semibold">{fullAddress}</span>
          </span>
        </li>
        <li>
          <a
            href={site.facebook}
            target="_blank"
            rel="noopener"
            class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-5 transition hover:border-oak/50"
          >
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 text-oak">
              <Icon name="facebook" size={22} />
            </span>
            <span>
              <span class="block text-xs tracking-[0.18em] text-white/50 uppercase">Facebook</span>
              <span class="block text-lg font-semibold group-hover:text-oak">facebook.com/JuTrStol</span>
            </span>
          </a>
        </li>
      </ul>

      <div class="mt-6 overflow-hidden rounded-2xl ring-1 ring-white/10" data-reveal style="--d:160ms">
        <iframe
          title="Mapa – JUTRSTOL, Gbely"
          src={`https://maps.google.com/maps?q=${mapQuery}&z=15&output=embed`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="h-56 w-full grayscale-[0.4] sepia-[0.15]"></iframe>
      </div>
    </div>

    <form
      id="contact-form"
      data-web3
      data-key={site.web3formsKey}
      class="relative rounded-[1.75rem] bg-paper p-6 text-ink shadow-2xl sm:p-10"
      data-reveal
      style="--d:120ms"
      novalidate
    >
      <h3 class="text-3xl font-medium">Nezáväzný dopyt</h3>
      <p class="mt-2 text-stone">Ozveme sa vám čo najskôr.</p>

      <input type="hidden" name="subject" value="Nový dopyt z webu JUTRSTOL" />
      <input type="hidden" name="from_name" value="Web JUTRSTOL" />
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        <label class="block">
          <span class="mb-2 block text-sm font-medium">Meno a priezvisko *</span>
          <input name="name" required autocomplete="name" class="field" placeholder="Ján Novák" />
        </label>
        <label class="block">
          <span class="mb-2 block text-sm font-medium">Telefón *</span>
          <input name="phone" type="tel" required autocomplete="tel" class="field" placeholder="09xx xxx xxx" />
        </label>
        <label class="block">
          <span class="mb-2 block text-sm font-medium">E-mail</span>
          <input name="email" type="email" autocomplete="email" class="field" placeholder="vas@email.sk" />
        </label>
        <label class="block">
          <span class="mb-2 block text-sm font-medium">Mesto / obec</span>
          <input name="city" autocomplete="address-level2" class="field" placeholder="Gbely" />
        </label>
      </div>

      <fieldset class="mt-6">
        <legend class="mb-3 text-sm font-medium">Čo potrebujete?</legend>
        <div class="flex flex-wrap gap-2">
          {
            [...categories.map((c) => c.title), 'Iné'].map((label) => (
              <label class="cursor-pointer">
                <input
                  type="checkbox"
                  name="type"
                  value={label}
                  checked={label === preselect}
                  class="peer sr-only"
                />
                <span class="inline-block rounded-full border border-line px-4 py-2 text-sm transition peer-checked:border-copper peer-checked:bg-copper peer-checked:text-white peer-focus-visible:ring-4 peer-focus-visible:ring-copper/25 hover:border-copper">
                  {label}
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <label class="mt-6 block">
        <span class="mb-2 block text-sm font-medium">Popíšte váš projekt *</span>
        <textarea
          name="message"
          required
          rows="5"
          class="field resize-y"
          placeholder="Napr. kuchyňa do L, cca 3,2 × 2,4 m, biele matné dvierka, termín na jar…"></textarea>
      </label>

      <label class="mt-6 flex items-start gap-3 text-sm text-stone">
        <input type="checkbox" name="gdpr" required class="mt-0.5 h-5 w-5 shrink-0 accent-copper" />
        <span>
          Súhlasím so spracovaním osobných údajov za účelom vybavenia dopytu podľa{' '}
          <a href="/ochrana-osobnych-udajov" class="underline decoration-oak underline-offset-2 hover:text-copper"
            >zásad ochrany osobných údajov</a
          >. *
        </span>
      </label>

      <button type="submit" class="btn-primary mt-8 w-full !py-4 text-base">
        Odoslať dopyt <Icon name="arrow" size={18} />
      </button>

      <p data-status role="status" aria-live="polite" class="mt-4 hidden rounded-xl px-4 py-3 text-sm"></p>
      <p class="mt-4 text-center text-sm text-stone">
        Alebo rovno zavolajte: <a href={telHref} class="font-semibold text-ink hover:text-copper">{site.phoneDisplay}</a>
      </p>
    </form>
  </div>
</section>

<script>
  import { bindForms } from '../scripts/forms';
  bindForms();
</script>

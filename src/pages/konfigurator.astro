---
import Base from '../layouts/Base.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Icon from '../components/Icon.astro';
import { site, telHref, configuratorHref } from '../data/site';

const types = [
  { key: 'kuchyna', label: 'Kuchyňa', icon: 'kitchen' },
  { key: 'satnik', label: 'Šatník', icon: 'hanger' },
] as const;
---

<Base
  title="3D konfigurátor nábytku – kuchyne a šatníky"
  description="Navrhnite si kuchyňu alebo šatník v 3D a pošlite nám návrh. Cenu pripravíme po bezplatnom zameraní u vás. Stolárstvo JUTRSTOL, Gbely."
>
  <section class="cfg-page" data-nav="Konfigurátor">
    <!-- Krátky úvod nad konfigurátorom -->
    <div class="container-x flex flex-col gap-5 pt-28 pb-6 sm:pt-32 lg:flex-row lg:items-end lg:justify-between lg:gap-10">
      <div class="max-w-2xl">
        <p class="eyebrow">3D konfigurátor</p>
        <h1 class="mt-4 text-[2rem] leading-[1.05] font-semibold sm:text-5xl">
          Navrhnite si kuchyňu alebo šatník <span class="script text-copper">v 3D</span>
        </h1>
        <p class="mt-3 text-[17px] leading-relaxed text-stone">
          Cenu pripravíme po bezplatnom zameraní u vás.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <nav class="type-switch" aria-label="Typ nábytku">
          {
            types.map((t) => (
              <a href={`/konfigurator?typ=${t.key}`} data-type={t.key} data-astro-reload>
                <Icon name={t.icon} size={17} /> {t.label}
              </a>
            ))
          }
        </nav>
        <a href="#dopyt" class="text-sm font-semibold text-stone underline decoration-oak underline-offset-4 hover:text-ink">
          Radšej bez konfigurátora
        </a>
      </div>
    </div>

    <!-- Konfigurátor: na mobile cez celú šírku, na počítači s jemným okrajom -->
    <div class="cfg-shell lg:px-3">
      <div class="cfg-box relative overflow-hidden bg-paper lg:rounded-[1.75rem]">
        <div class="cfg-loading absolute inset-0 flex flex-col items-center justify-center gap-3 text-stone" aria-hidden="true">
          <span class="h-8 w-8 animate-spin rounded-full border-2 border-line border-t-copper"></span>
          Načítavam 3D konfigurátor…
        </div>
        <iframe
          id="cfg-frame"
          data-base={configuratorHref}
          data-param={site.configurator.typeParam}
          data-types={site.configurator.types.join(',')}
          title="3D konfigurátor nábytku"
          allow="fullscreen; camera; xr-spatial-tracking"
          allowfullscreen
          loading="eager"
          class="relative block w-full border-0"></iframe>
        <script is:inline>
          // Adresu nastavíme hneď (bez dvojitého načítania): ?typ= z adresy webu ide ďalej do konfigurátora
          (function () {
            var f = document.getElementById('cfg-frame');
            if (!f || f.src) return;
            var url = new URL(f.dataset.base);
            var typ = new URLSearchParams(location.search).get('typ');
            if (typ && f.dataset.types.split(',').indexOf(typ) !== -1) url.searchParams.set(f.dataset.param, typ);
            f.src = url.href;
          })();
        </script>
        <noscript>
          <p class="p-10 text-center">
            <a href={configuratorHref} class="btn-primary">Otvoriť konfigurátor</a>
          </p>
        </noscript>
      </div>
    </div>

    <p class="container-x mt-4 text-center text-sm text-stone">
      Konfigurátor sa nenačítal?{' '}
      <a href={configuratorHref} data-cfg-link target="_blank" rel="noopener" class="font-semibold text-ink underline decoration-oak underline-offset-4">
        Otvoriť ho v novom okne
      </a>
      {' '}alebo zavolajte <a href={telHref} class="font-semibold text-ink">{site.phoneDisplay}</a>.
    </p>
  </section>

  <!-- Alternatíva: obyčajný dopyt -->
  <section id="dopyt" class="sheet soft-bg mt-16 scroll-mt-24 pt-20 pb-28 lg:pt-24 lg:pb-32" data-nav="Obyčajný dopyt">
    <div class="container-x grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
      <div>
        <p class="eyebrow">Obyčajný dopyt</p>
        <h2 class="mt-5 text-3xl font-semibold sm:text-4xl">Radšej bez konfigurátora?</h2>
        <p class="mt-4 text-lg leading-relaxed text-stone">
          Napíšte pár viet, pridajte približné rozmery a ozveme sa vám. Návrh pripravíme spolu pri zameraní.
        </p>
        <ul class="mt-6 space-y-3 text-stone">
          {
            ['stačí krátky popis a telefón', 'rozmery zameriame sami', 'zameranie a návrh sú pri realizácii zadarmo'].map((t) => (
              <li class="flex items-center gap-3">
                <Icon name="check" size={18} class="text-copper" />
                {t}
              </li>
            ))
          }
        </ul>
      </div>
      <InquiryForm flat />
    </div>
  </section>
</Base>

<style>
  .type-switch {
    display: inline-flex;
    gap: 4px;
    border-radius: 1.1rem;
    background: white;
    padding: 4px;
    box-shadow: inset 0 0 0 1px rgb(29 26 23 / 0.08);
  }
  .type-switch a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border-radius: 0.85rem;
    padding: 0.6rem 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-stone);
    transition:
      background 0.2s,
      color 0.2s;
  }
  .type-switch a:hover {
    color: var(--color-ink);
  }
  .type-switch a[aria-current='page'] {
    background: var(--color-walnut);
    color: var(--color-oak);
  }
  /* Výška = zvyšok okna pod plávajúcou hlavičkou (5.5rem), aspoň 640 px */
  #cfg-frame {
    height: max(640px, calc(100dvh - 5.5rem));
  }
  .cfg-box {
    box-shadow:
      0 0 0 1px rgb(29 26 23 / 0.08),
      0 50px 100px -50px rgb(29 26 23 / 0.6);
  }
  .cfg-shell {
    scroll-margin-top: 5.5rem;
  }
  /* Na stránke konfigurátora skryjeme mobilnú lištu, aby neprekrývala ovládanie */
  :global(body:has(#cfg-frame) .mobile-cta) {
    display: none;
  }
</style>

<script>
  type CfgMessage = { type?: string; vyska?: number; klient?: string; typ?: string };
  type Tracker = {
    gtag?: (...args: unknown[]) => void;
    fbq?: (...args: unknown[]) => void;
    dataLayer?: unknown[];
  };

  const CFG_ORIGIN = 'https://stolar-konfigurator.vercel.app';

  // Správy z konfigurátora – zaregistrované raz pre celý web
  window.addEventListener('message', (event: MessageEvent<CfgMessage>) => {
    if (event.origin !== CFG_ORIGIN) return;
    const frame = document.getElementById('cfg-frame') as HTMLIFrameElement | null;
    const data = event.data;
    if (!frame || !data || typeof data !== 'object') return;

    if (data.type === 'konfigurator:vyska' && typeof data.vyska === 'number') {
      // Len zväčšovať – nikdy pod výšku okna
      frame.style.height = '';
      const base = frame.getBoundingClientRect().height;
      if (data.vyska > base) frame.style.height = `${Math.ceil(data.vyska)}px`;
    }

    if (data.type === 'konfigurator:odoslane') {
      // Konverzia: zákazník odoslal dopyt z konfigurátora
      const w = window as unknown as Tracker;
      const typ = data.typ ?? 'neznamy';
      w.gtag?.('event', 'generate_lead', { method: 'konfigurator', typ });
      w.fbq?.('track', 'Lead', { content_category: typ });
      w.dataLayer?.push({ event: 'generate_lead', method: 'konfigurator', typ });
    }
  });

  document.addEventListener('astro:page-load', () => {
    const frame = document.getElementById('cfg-frame') as HTMLIFrameElement | null;
    if (!frame) return;
    frame.addEventListener('load', () => document.querySelector<HTMLElement>('.cfg-loading')?.remove(), { once: true });

    // Aktívny typ v prepínači a odkaz „v novom okne“ podľa toho, čo je v iframe
    const current = new URL(frame.src || frame.dataset.base!);
    const typ = current.searchParams.get(frame.dataset.param!) ?? 'kuchyna';
    document.querySelectorAll<HTMLAnchorElement>('.type-switch a').forEach((a) => {
      if (a.dataset.type === typ) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
    document.querySelectorAll<HTMLAnchorElement>('[data-cfg-link]').forEach((a) => (a.href = current.href));
  });
</script>

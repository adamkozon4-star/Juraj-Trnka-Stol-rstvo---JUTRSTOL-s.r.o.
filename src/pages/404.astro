---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Stránka sa nenašla" description="Táto stránka neexistuje." noindex overlayHeader>
  <section class="wood-grain flex min-h-[80svh] items-center bg-walnut pt-24 text-white">
    <div class="container-x text-center">
      <p class="font-serif text-8xl text-oak">404</p>
      <h1 class="mt-6 text-4xl font-medium sm:text-5xl">Táto stránka sa nenašla</h1>
      <p class="mx-auto mt-5 max-w-md text-white/70">Možno bola presunutá. Skúste úvodnú stránku alebo naše realizácie.</p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn-primary">Na úvod <Icon name="arrow" size={18} /></a>
        <a href="/realizacie" class="btn-ghost">Realizácie</a>
      </div>
    </div>
  </section>
</Base>

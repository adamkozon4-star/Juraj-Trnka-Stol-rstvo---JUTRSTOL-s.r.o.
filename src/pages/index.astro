---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import AboutSheet from '../components/home/AboutSheet.astro';
import Services from '../components/home/Services.astro';
import Featured from '../components/home/Featured.astro';
import Reviews from '../components/home/Reviews.astro';
import Process from '../components/home/Process.astro';
import ConfiguratorTeaser from '../components/home/ConfiguratorTeaser.astro';
import Faq from '../components/home/Faq.astro';
import Contact from '../components/Contact.astro';
---

<Base
  title="JUTRSTOL – Stolárstvo Gbely | Kuchyne a nábytok na mieru"
  description="Stolárstvo JUTRSTOL, Juraj Trnka – 25 rokov skúseností. Kuchyne, vstavané skrine, predsiene, detské izby a interiéry na mieru. Zameranie, výroba vo vlastnej dielni v Gbeloch a montáž. Záhorie a okolie."
  overlayHeader
>
  <Hero />
  <AboutSheet />
  <Services />
  <Featured />
  <Reviews />
  <Process />
  <ConfiguratorTeaser />
  <Faq />
  <Contact />
</Base>
